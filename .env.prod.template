# ============================================================
# Troxe Hosting — Production Environment Template
# ============================================================
# Copy to .env.prod and fill in ALL values (no defaults in prod).
# Run: cp .env.prod.template .env.prod && editor .env.prod
# ============================================================

# ----- Domain (used by Caddy + API CORS) -----
DOMAIN=troxe.example.com

# ----- PostgreSQL -----
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD_32_CHARS_MIN

# ----- JWT Secrets (48 bytes each, base64url) -----
# Generate: openssl rand -base64 48 | tr -d '=\n'
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_48_BYTES_BASE64URL
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_48_BYTES_BASE64URL

# ----- Environment Encryption Key (32 bytes hex) -----
# Generate: openssl rand -hex 32
ENV_ENCRYPTION_KEY=CHANGE_ME_ENV_ENCRYPTION_KEY_64_HEX_CHARS

# ----- Optional: Rate limit window (ms) -----
# RATE_LIMIT_WINDOW_MS=60000
# AUTH_RATE_LIMIT_MAX=8
# LOCKOUT_THRESHOLD=6
# LOCKOUT_DECAY_SEC=600      # stale failures stop counting toward the lock

# ----- Optional: dedicated WebSocket ticket key -----
# When unset, derived automatically from JWT_ACCESS_SECRET (HKDF) — you never
# have to share the JWT signing key with the WS ticket signer.
# WS_TICKET_SECRET=

# ----- Optional: Backup limits -----
# BACKUP_MAX_TOTAL_MB=5120   # owner-wide total
# BACKUP_MAX_MB=2048         # single archive (enforced while writing)

# ----- Optional: disk guard -----
# DISK_BLOCK_PCT=90          # placement refuses nodes at/above this usage

# ----- Optional: Log level (verbose|debug|log|warn|error) -----
# LOG_LEVEL=log
# ----- Optional: Email via Resend (empty = disabled) -----
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=noreply@example.com
# RESEND_FROM_NAME=Troxe
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
# APP_URL=https://hosting.example.com
