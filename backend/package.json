{
  "name": "troxe-api",
  "version": "1.0.0",
  "private": true,
  "description": "Troxe Hosting API  NestJS + Drizzle + PostgreSQL + Docker",
  "scripts": {
    "start:dev": "nest start --watch",
    "start": "nest start",
    "build": "nest build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "ts-node --transpile-only src/db/seed.ts",
    "test:unit": "DATABASE_URL=postgresql://test:test@localhost:5432/test node --experimental-strip-types --loader ./test/loader.mjs --test test/unit/oauth-helpers.test.ts test/unit/oauth-service.test.ts test/unit/email-templates.test.ts test/unit/email-tokens.test.ts test/unit/email-service.test.ts test/unit/deps-prelude.test.ts test/unit/two-factor.test.ts test/unit/announcements.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.2.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/platform-socket.io": "^11.2.6",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.6",
    "@types/multer": "^2.3.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "dockerode": "^5.0.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.3",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.0.0",
    "multer": "^2.4.0",
    "otpauth": "^9.5.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.32.0",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "svix": "^2.6.1",
    "tar-stream": "^2.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^20.16.13",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
