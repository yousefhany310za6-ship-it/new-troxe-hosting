# ── troxe-api configuration ─────────────────────────────────────────────────
# Copy to .env. The process REFUSES to start in production when a secret is
# missing, short or reused — generate them before deploying.

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3300
LOG_LEVEL=log

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://troxe:change-me@127.0.0.1:5432/troxe
PG_POOL_MAX=10
PG_SSL=false
PG_STATEMENT_TIMEOUT_MS=15000

# ── Secrets (REQUIRED in production) ─────────────────────────────────────────
# openssl rand -base64 48
JWT_ACCESS_SECRET=
# openssl rand -base64 48   (must be different from the access secret)
JWT_REFRESH_SECRET=
# openssl rand -hex 32      (exactly 64 hex chars — AES-256 for server env vars)
ENV_ENCRYPTION_KEY=
# Optional: dedicated WS-ticket key. When unset it is derived from
# JWT_ACCESS_SECRET via HKDF (purpose-separated — never the JWT key itself).
# WS_TICKET_SECRET=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SEC=604800
BCRYPT_ROUNDS=12

# ── CORS / proxy ─────────────────────────────────────────────────────────────
# comma separated, no "*" when credentials are used
FRONTEND_URLS=https://troxe.host,http://localhost:5173
# set true ONLY when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# ── Hosting platform ─────────────────────────────────────────────────────────
REGIONS=fra-de
MAX_SERVERS_PER_USER=10
MAX_ENV_VARS=40
AUTO_START_ON_CREATE=true

# ── Docker sandbox isolation ─────────────────────────────────────────────────
DOCKER_ENABLED=true
DOCKER_SOCKET=/var/run/docker.sock
# helper image for volume maintenance (chown / tar / du) — digest-pinned;
# overrides must also be digest refs (name@sha256:...), enforced in prod
HELPER_IMAGE=alpine@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
# iptables DOCKER-USER rules: client → host / LAN / metadata = DROP
HARDEN_NETWORK=true
CONTAINER_PIDS_LIMIT=512

# ── Backups ──────────────────────────────────────────────────────────────────
BACKUP_DIR=./data/backups
BACKUP_MAX_TOTAL_MB=2048

# ── Rate limiting / brute-force protection ───────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=8
LOCKOUT_THRESHOLD=6
# Failures older than this stop counting toward the lockout (so scattered
# typos never lock an account; a burst inside the window still does).
LOCKOUT_DECAY_SEC=600
