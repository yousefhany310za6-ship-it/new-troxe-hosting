# ── troxe-api configuration ─────────────────────────────────────────────────
# Copy to .env. The process REFUSES to start in production when a secret is
# missing, short or reused — generate them before deploying.

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3300
LOG_LEVEL=log

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://troxe:change-me@127.0.0.1:5432/troxe
PG_POOL_MAX=10
PG_SSL=false
PG_STATEMENT_TIMEOUT_MS=15000

# ── Secrets (REQUIRED in production) ─────────────────────────────────────────
# openssl rand -base64 48
JWT_ACCESS_SECRET=
# openssl rand -base64 48   (must be different from the access secret)
JWT_REFRESH_SECRET=
# openssl rand -hex 32      (exactly 64 hex chars — AES-256 for server env vars)
ENV_ENCRYPTION_KEY=
# Optional: dedicated WS-ticket key. When unset it is derived from
# JWT_ACCESS_SECRET via HKDF (purpose-separated — never the JWT key itself).
# WS_TICKET_SECRET=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SEC=604800
BCRYPT_ROUNDS=12

# ── CORS / proxy ─────────────────────────────────────────────────────────────
# comma separated, no "*" when credentials are used
FRONTEND_URLS=https://troxe.host,http://localhost:5173
# set true ONLY when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# ── Hosting platform ─────────────────────────────────────────────────────────
REGIONS=fra-de
MAX_SERVERS_PER_USER=10
MAX_ENV_VARS=40
AUTO_START_ON_CREATE=true

# ── Docker sandbox isolation ─────────────────────────────────────────────────
DOCKER_ENABLED=true
DOCKER_SOCKET=/var/run/docker.sock
# helper image for volume maintenance (chown / tar / du) — digest-pinned;
# overrides must also be digest refs (name@sha256:...), enforced in prod
HELPER_IMAGE=alpine@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
# iptables DOCKER-USER rules: client → host / LAN / metadata = DROP
HARDEN_NETWORK=true
CONTAINER_PIDS_LIMIT=512

# ── Backups ──────────────────────────────────────────────────────────────────
BACKUP_DIR=./data/backups
# Backup byte caps: per-archive ceiling (enforced WHILE writing — a huge
# volume can never fill the disk mid-backup) and the owner-wide total.
BACKUP_MAX_MB=2048
BACKUP_MAX_TOTAL_MB=2048

# ── Disk guard ──────────────────────────────────────────────────────────────
# Placement refuses to put NEW servers on a node at/above this usage, and the
# reconciler warns (hourly) when a node crosses it. Measured on every node
# itself with df (read-only bind of its /), cached 60s. 0..100.
DISK_BLOCK_PCT=90

# ── Rate limiting / brute-force protection ───────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=8
LOCKOUT_THRESHOLD=6

# ── OAuth login (Google + Discord) ───────────────────────────────────────────
# Leave a provider's pair empty to disable it. In production a half-configured
# provider refuses to boot. Secrets never leave the API (no frontend usage).
#
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web):
#   Authorized redirect URI: <OAUTH_REDIRECT_BASE_URL>/api/v1/auth/oauth/google/callback
#   Scopes requested at runtime: openid email profile (minimum)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# Discord Developer Portal → your application → OAuth2:
#   Redirect: <OAUTH_REDIRECT_BASE_URL>/api/v1/auth/oauth/discord/callback
#   Scopes requested at runtime: identify email guilds.join (minimum)
#   Bot: create/reset a bot token below AND add the bot to your server first —
#   guild auto-join calls fail while the bot is not a member of the guild.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot token (server-side only) + the guild users are auto-added to.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
#
# Bare public origin of THIS api (no path, no trailing slash) used to build
# the exact redirect_uri sent to the providers, e.g. https://api.troxe.host.
# Required when any OAuth provider is enabled.
OAUTH_REDIRECT_BASE_URL=
# Where the browser lands after the backend callback. Defaults to the first
# FRONTEND_URLS entry; must be one of FRONTEND_URLS when set.
#OAUTH_FRONTEND_URL=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Leave the pair empty to disable sending (endpoints answer 503, auth keeps
# working). Secrets never leave the API.
# Resend dashboard → API Keys → create key (sending access)
RESEND_API_KEY=
# Verified sender, e.g. noreply@troxe.net (domain must be verified in Resend)
RESEND_FROM_EMAIL=
# Display name on outgoing mail
RESEND_FROM_NAME=Troxe
# Resend dashboard → Webhooks → your endpoint → Signing Secret (optional;
# without it webhook events are rejected)
RESEND_WEBHOOK_SECRET=
# Bare public origin of the SITE (no path) used for links inside emails:
# password reset, marketing unsubscribe. e.g. https://troxe.net
APP_URL=
# Failures older than this stop counting toward the lockout (so scattered
# typos never lock an account; a burst inside the window still does).
LOCKOUT_DECAY_SEC=600
