{
    email admin@{DOMAIN}
    # staging for testing: change to `acme_ca https://acme-v02.api.letsencrypt.org/directory` for prod
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# ---- Frontend (static files served by Caddy) ----
{DOMAIN}, www.{DOMAIN} {
    root * /var/www/html
    file_server
    encode zstd gzip
    header {
        # Security headers
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }
    # Hashed build assets never change: cache hard. index.html (and everything
    # else) must always be revalidated so a deploy is picked up immediately.
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    @notassets not path /assets/*
    header @notassets Cache-Control "no-cache"
    # SPA fallback: unknown routes -> index.html, but NEVER for /assets/*: a
    # missing chunk must be a real 404, not index.html served as JavaScript.
    @spa {
        not path /assets/*
        not file
    }
    rewrite @spa /index.html
}

# ---- API reverse proxy ----
# NOTE: the API runs with `network_mode: host`, so compose MUST put Caddy on
# the host netns too — otherwise this 127.0.0.1 is Caddy's own loopback and
# every API call returns 502. See docker-compose.prod.yml (caddy service).
api.{DOMAIN} {
    reverse_proxy http://127.0.0.1:3300 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    # NOTE: auth rate limiting is enforced by the API (AUTH_RATE_LIMIT_MAX); the
    # stock caddy image has no `rate_limit` directive.
}