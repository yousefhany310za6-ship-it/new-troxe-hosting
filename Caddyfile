{
    email admin@{DOMAIN}
    # staging for testing: change to `acme_ca https://acme-v02.api.letsencrypt.org/directory` for prod
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# ---- Frontend (static files served by Caddy) ----
{DOMAIN}, www.{DOMAIN} {
    root * /var/www/html
    file_server
    encode zstd gzip
    header {
        # Security headers
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }
    # SPA fallback: unknown routes -> index.html
    try_files {path} /index.html
}

# ---- API reverse proxy ----
api.{DOMAIN} {
    reverse_proxy http://127.0.0.1:3300 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    # Rate limiting on auth endpoints (8/min per IP shared)
    @auth path /api/v1/auth/login /api/v1/auth/signup /api/v1/auth/refresh
    rate_limit @auth {
        zone auth_limit 10m
        key {remote_host}
        events 8
        window 1m
    }
}